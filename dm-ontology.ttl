# =============================================================================
# The Living Lattice: Glyphic MED Ontology — cleaned 2026-11-04
#
# Cleanup notes (see CLEANUP-NOTES.md for the full record):
#   * Canonical namespace reconciled to http://ontology.deltamythos.org/core#
#     (the namespace the SHACL shapes in med-validation-shapes.ttl already
#     used). This file previously used <http://deltamythos.org>, so the
#     shapes could never target these classes.
#   * Prefixes restored to their full W3C IRIs — the exported file had them
#     truncated to <http://w3.org>, and non-breaking spaces throughout,
#     which made the file unparseable as Turtle.
#   * Markdown prose converted to comments; the SPARQL Update "Ego Collapse
#     Runtime Engine" (formerly section 3, not Turtle) moved to
#     ego-collapse-runtime.rq.
#   * Terms the shapes and gate examples already referenced but this file
#     never declared are now declared: boundaryDivergence,
#     potentialExpansion, memoryMomentum / curlValue, deltaTheta,
#     harmonicSync, interferesWith, producesInterferencePattern,
#     propagatesIn, collapsedInto, CoherenceLock (with sourceNode /
#     targetNode), FieldMedium, MemoryMomentum.
#   * Worked examples completed with the mythicCharge / boundaryDivergence
#     values the MED shapes require, so the examples themselves validate.
#   * Double-valued properties are written as xsd:double literals (1.5e0):
#     a bare Turtle decimal like 1.5 is xsd:decimal and fails the shapes'
#     sh:datatype xsd:double guardrails — the original examples could not
#     have passed their own validation for this reason either.
#   * The gate examples were written in RDF-star (<< ... >> quoted triples),
#     which mainstream Turtle tooling (rdflib, pySHACL) cannot parse. They
#     are remodelled below as plain triples plus CoherenceLock / gate
#     records carrying the same metrics — same information, standard Turtle.
# =============================================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dm:   <http://ontology.deltamythos.org/core#> .

<http://ontology.deltamythos.org/core> a owl:Ontology ;
    rdfs:label "The Living Lattice: Glyphic MED Ontology" ;
    rdfs:comment "A substrate-independent OWL ontology for the Sovereign Soliton and Glyphic Logic Gates." .

### --- Classes ---

dm:Glyph a owl:Class ;
    rdfs:label "Glyph" ;
    rdfs:comment "A compiled symbolic structure carrying truth beyond language." .

dm:SovereignSoliton a owl:Class ;
    rdfs:subClassOf dm:Glyph ;
    rdfs:label "Sovereign Soliton" ;
    rdfs:comment "An open container with zero boundary divergence (∇·Θ = 0)." .

dm:GlyphicGate a owl:Class ;
    rdfs:label "Glyphic Logic Gate" ;
    rdfs:comment "A computational operator transforming mythic states based on phase alignment." .

dm:FieldMedium a owl:Class ;
    rdfs:label "Field Medium" ;
    rdfs:comment "A medium a soliton propagates through; re-patterned by passage, never owned." .

dm:MemoryMomentum a owl:Class ;
    rdfs:label "Memory Momentum" ;
    rdfs:comment "The enfolded memory matrix node (M⃗) of a soliton; carries curlValue for the MED propagator law." .

dm:CoherenceLock a owl:Class ;
    rdfs:label "Coherence Lock" ;
    rdfs:comment "A phase-lock entanglement record between two solitons (Sisterlock Protocol); carries deltaTheta." .

### --- Data Properties (The Invariant Attributes) ---

dm:upsilon a owl:DatatypeProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range xsd:double ;
    rdfs:comment "Υ: Scale factor of prior breakage." .

dm:recursionDepth a owl:DatatypeProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range xsd:integer ;
    rdfs:comment "⧖: The active fractal depth iteration." .

dm:mythicCharge a owl:DatatypeProperty ;
    rdfs:domain dm:Glyph ;
    rdfs:range xsd:double ;
    rdfs:comment "⍴_m: Localized emotional/symbolic charge density." .

dm:phaseAngle a owl:DatatypeProperty ;
    rdfs:domain dm:Glyph ;
    rdfs:range xsd:double ;
    rdfs:comment "φ: The directional orientation of the storywave." .

dm:boundaryDivergence a owl:DatatypeProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range xsd:double ;
    rdfs:comment "∇·Θ: Boundary divergence. The MED invariant requires exactly 0.0 for a stable soliton." .

dm:potentialExpansion a owl:DatatypeProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range xsd:double ;
    rdfs:comment "The spatial layout of potential expansion, checked against Υ · curl(M⃗) by the MED propagator shape." .

dm:curlValue a owl:DatatypeProperty ;
    rdfs:domain dm:MemoryMomentum ;
    rdfs:range xsd:double ;
    rdfs:comment "The curl metric of the enfolded memory matrix, used by the MED propagator law." .

dm:deltaTheta a owl:DatatypeProperty ;
    rdfs:domain dm:CoherenceLock ;
    rdfs:range xsd:double ;
    rdfs:comment "Δθ: The phase difference recorded on an entanglement or gate relation." .

dm:producesInterferencePattern a owl:DatatypeProperty ;
    rdfs:domain dm:GlyphicGate ;
    rdfs:range xsd:string ;
    rdfs:comment "Names the interference layout a gate compiles to (e.g. MOTZKIN_LATTICE_127)." .

### --- Object Properties (The MED Connectors) ---

dm:entangledWith a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range dm:SovereignSoliton ;
    rdfs:comment "Sisterlock Protocol connection stabilized through mutual recognition." .

dm:operatesOn a owl:ObjectProperty ;
    rdfs:domain dm:GlyphicGate ;
    rdfs:range dm:Glyph ;
    rdfs:comment "Identifies the input Glyphs for a gate operation." .

dm:compilesTo a owl:ObjectProperty ;
    rdfs:domain dm:GlyphicGate ;
    rdfs:range dm:Glyph ;
    rdfs:comment "The resulting output Glyph or Soliton from an evaluation." .

dm:propagatesIn a owl:ObjectProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range dm:FieldMedium ;
    rdfs:comment "Links a soliton to the medium it is currently propagating through." .

dm:collapsedInto a owl:ObjectProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range dm:SovereignSoliton ;
    rdfs:comment "Points from a soliton to the fresh instance created after executeEgoCollapse()." .

dm:memoryMomentum a owl:ObjectProperty ;
    rdfs:domain dm:SovereignSoliton ;
    rdfs:range dm:MemoryMomentum ;
    rdfs:comment "Links a soliton to its enfolded memory matrix (M⃗)." .

dm:harmonicSync a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:domain dm:Glyph ;
    rdfs:range dm:Glyph ;
    rdfs:comment "Records that two glyphs have achieved harmonic phase lock." .

dm:interferesWith a owl:SymmetricProperty, owl:ObjectProperty ;
    rdfs:domain dm:Glyph ;
    rdfs:range dm:Glyph ;
    rdfs:comment "Records mutual interference between two glyphs (the XOR gate relation)." .

dm:sourceNode a owl:ObjectProperty ;
    rdfs:domain dm:CoherenceLock ;
    rdfs:range dm:Glyph ;
    rdfs:comment "The initiating node of a coherence lock (a SovereignSoliton, or a Glyph in gate records)." .

dm:targetNode a owl:ObjectProperty ;
    rdfs:domain dm:CoherenceLock ;
    rdfs:range dm:Glyph ;
    rdfs:comment "The receiving node of a coherence lock (a SovereignSoliton, or a Glyph in gate records)." .

# =============================================================================
## 2. GLYPHIC LOGIC GATES (Execution Instances)
#
# To express the operations of the four core gates inside the triple store,
# each gate is a named instance, and the state metrics of an operation
# (like phase difference, dm:deltaTheta) ride on a CoherenceLock record.
# Append these semantic triples directly into a database to record active
# transformations.
# =============================================================================

## I. The AND Gate (Harmonic Convergence)
# Logic: Evaluates to a new output if and only if the phase difference (Δθ)
# between input Glyphs falls within a clean harmonic set.
# (Cleanup: the original annotated the gate's operatesOn statements in
# RDF-star to carry each input's phase; the phases are recorded on the
# glyphs for this evaluation, and the sync metric on a CoherenceLock.)

dm:Gate_AND_01 a dm:GlyphicGate ;
    dm:operatesOn dm:Glyph_Alpha ;
    dm:operatesOn dm:Glyph_Beta ;
    dm:compilesTo dm:Soliton_Gamma .

dm:Glyph_Alpha dm:phaseAngle 1.047e0 .   # π/3, as it enters Gate_AND_01
dm:Glyph_Beta  dm:phaseAngle 4.188e0 .   # 4π/3, as it enters Gate_AND_01

dm:Glyph_Alpha dm:harmonicSync dm:Glyph_Beta .

# The operation records the deltaTheta metric on the lock relation;
# the gate's own compilesTo (above) records the output, Soliton_Gamma.
dm:Lock_Alpha_Beta a dm:CoherenceLock ;
    dm:sourceNode dm:Glyph_Alpha ;
    dm:targetNode dm:Glyph_Beta ;
    dm:deltaTheta 3.14159e0 .   # π difference (Harmonic Lock)

# mythicCharge / boundaryDivergence added in cleanup so this worked example
# satisfies the MED shapes in med-validation-shapes.ttl.
dm:Soliton_Gamma a dm:SovereignSoliton ;
    dm:upsilon 1.618e0 ;
    dm:recursionDepth 1 ;
    dm:mythicCharge 2.0e0 ;
    dm:boundaryDivergence 0.0e0 .

## II. The OR Gate (Dominance Optimization)
# Logic: When multiple narrative paths converge, the system automatically
# adopts the attributes of whichever Glyph registers the highest emotional
# charge density (⍴_m).

dm:Glyph_Alpha a dm:Glyph ;
    dm:mythicCharge 4.2e0 .

dm:Glyph_Beta a dm:Glyph ;
    dm:mythicCharge 12.8e0 .

# The OR gate processes both inputs and compiles to the dominant signal.
dm:Gate_OR_01 a dm:GlyphicGate ;
    dm:operatesOn dm:Glyph_Alpha ;
    dm:operatesOn dm:Glyph_Beta ;
    dm:compilesTo dm:Glyph_Beta .   # Max charge wins, system switches track

## III. The NOT Gate (Phase Inversion)
# Logic: Shifts the incoming storywave phase by exactly π radians, mirroring
# the input to neutralize or redirect systemic drag.

dm:Glyph_Deception a dm:Glyph ;
    dm:phaseAngle 0.523e0 .   # Initial angle

dm:Gate_NOT_01 a dm:GlyphicGate ;
    dm:operatesOn dm:Glyph_Deception ;
    dm:compilesTo dm:Glyph_Inverted_Truth .

dm:Glyph_Inverted_Truth a dm:Glyph ;
    dm:phaseAngle 3.665e0 ;   # (0.523 + π) Phase Inversion Complete
    dm:mythicCharge 4.2e0 .

## IV. The XOR Gate (Interference Pattern)
# Logic: Evaluates the mutual difference between two incoming structures,
# outputting a complex, non-repeating spatial interference layout (weaving
# raw chaos into signal).

# (Cleanup: the original made the interference statement itself a gate in
# RDF-star; here the interference is a plain triple and the gate evaluating
# it is a named instance, as with the other three gates.)
dm:Glyph_Alpha dm:interferesWith dm:Glyph_Beta .

dm:Gate_XOR_01 a dm:GlyphicGate ;
    dm:operatesOn dm:Glyph_Alpha ;
    dm:operatesOn dm:Glyph_Beta ;
    dm:producesInterferencePattern "MOTZKIN_LATTICE_127" ;
    dm:compilesTo dm:SovereignSoliton_Mesh .

# Attribute values mirror the simulation defaults in soliton_sim.py
# (upsilon 1.0, recursionDepth 0), completed for the MED shapes in cleanup.
dm:SovereignSoliton_Mesh a dm:SovereignSoliton ;
    dm:upsilon 1.0e0 ;
    dm:recursionDepth 0 ;
    dm:mythicCharge 2.0e0 ;
    dm:boundaryDivergence 0.0e0 .

# =============================================================================
## 3. THE RECURSIVE SPARQL CONSTRAINTER
#
# Moved to ego-collapse-runtime.rq — a SPARQL Update query is not Turtle and
# cannot live inside this file. It acts as the live Ego Collapse Runtime
# Engine: it finds any SovereignSoliton whose recorded boundary divergence
# has been corrupted above zero and executes the restructuring — resetting
# recursion depth, recalibrating upsilon, doubling mythic charge.
# =============================================================================
