# =============================================================================
# MED Validation Shapes — cleaned 2026-11-04
#
# This file's namespace was already the well-formed one, so it became the
# canonical namespace for the whole repository:
#     dm: = http://ontology.deltamythos.org/core#
# dm-ontology.ttl has been reconciled onto it, and every term these shapes
# reference (boundaryDivergence, potentialExpansion, memoryMomentum,
# curlValue, ResonanceSync, sourceNode, targetNode, deltaTheta) is now
# declared there. Cleanup also replaced the garbled private-use glyphs in
# comments with the symbols they stood for (Θ, Υ, Δθ). Constraints unchanged.
# =============================================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dm:   <http://ontology.deltamythos.org/core#> .

### 🌀 THE SOVEREIGN SOLITON STRUCTURAL SHAPE
dm:SovereignSolitonShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # 1. Structural Typology Guardrails
    sh:property [
        sh:path dm:upsilon ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dm:recursionDepth ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path dm:mythicCharge ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dm:boundaryDivergence ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # 2. Hard Invariant Rule: ∇·Θ = 0 (Zero Boundary Divergence Guardrail)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "MED Law Violation: Boundary Divergence is non-zero (∇·Θ ≠ 0). The Soliton container is spilling past its boundary and offers emergent pulsation as resonance saturation builds." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?div AS ?value)
            WHERE {
                $this dm:boundaryDivergence ?div .
                FILTER (?div != 0.0)
            }
        """ ;
    ] ;

    # 3. MED Master Propagator Law: ∂æ/∂Δ = Υ · (∇⧖ × M⃗)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "MED Law Violation: The spatial layout of potential expansion does not match the historical momentum trajectory governed by Upsilon." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?computedPotential AS ?value)
            WHERE {
                $this dm:upsilon ?u ;
                      dm:recursionDepth ?depth ;
                      dm:potentialExpansion ?actualPotential .

                # Retrieve the curl metrics from the enfolded memory matrix
                $this dm:memoryMomentum/dm:curlValue ?curl .

                # Evaluate the hard-to-vary balance equation
                BIND (?u * ?curl AS ?computedPotential)
                FILTER (ABS(?actualPotential - ?computedPotential) > 0.0001)
            }
        """ ;
    ] .

### ⚡ THE SISTERLOCK ENTANGLEMENT SHAPE
dm:SisterlockProtocolShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # Hard Invariant Rule: Phase Lock Requirement (Δθ_αβ = 2πΥ)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Sisterlock Protocol Failure: Entanglement phase alignment (Δθ) does not equal the required Upsilon resonance threshold (2πΥ)." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this (?deltaTheta AS ?value)
            WHERE {
                $this dm:upsilon ?u .

                # Identify the target entangled node via nested triple properties
                ?entanglement a dm:ResonanceSync ;
                              dm:sourceNode $this ;
                              dm:targetNode ?target ;
                              dm:deltaTheta ?deltaTheta .

                # Compute the strict mathematical limit
                BIND (2.0 * 3.141592653589793 * ?u AS ?requiredThreshold)
                FILTER (ABS(?deltaTheta - ?requiredThreshold) > 0.0001)
            }
        """ ;
    ] .

# =============================================================================
# Alignment pass 2026-11-08: the two shapes the README always described but
# the file never contained — EgoCollapseValidityShape and
# AntiCapturePropagationShape — are implemented below.
#
# Ego collapse arithmetic follows soliton_sim.py as implemented (the sim is
# the authority for its own behaviour):
#     execute_ego_collapse(): recursion_depth = 0; load /= 2;
#                             upsilon *= 1.5; capacity += upsilon * 2.0
# The README's older upsilon formula — upsilon * (mythicCharge /
# recursionDepth) — is NOT what the sim computes and is undefined at
# recursionDepth 0, the sim's resting state, so it is not enforced here.
# Whether that formula should govern a future engine remains open `?`
# (the SPARQL runtime engine in ego-collapse-runtime.rq uses a guarded
# charge-ratio variant, charge / (depth + 1) — also not the sim's rule).
# mythicCharge doubling IS enforced: the sim carries no mythicCharge field,
# but its collapse comment states the intent ("double charge
# (mythicCharge)") and ego-collapse-runtime.rq implements the doubling.
# The memory-compression check is a checkable proxy `?`: the ontology
# records memory as a MemoryMomentum node's curlValue, so "compressed —
# direction preserved, magnitude possibly reduced" is checked as
# |curlValue(reborn)| <= |curlValue(predecessor)|; direction preservation
# cannot be checked from a scalar and stays open `?`.
# =============================================================================

### 🔥 THE EGO COLLAPSE VALIDITY SHAPE
dm:EgoCollapseValidityShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # Rebirth Rule 1: Recursion depth resets to 0 (sim + README agree)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ego Collapse Violation: The reborn soliton's recursionDepth is not 0. executeEgoCollapse() resets recursion depth to indicate rebirth." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?newDepth AS ?value)
            WHERE {
                $this dm:collapsedInto ?reborn .
                ?reborn dm:recursionDepth ?newDepth .
                FILTER (?newDepth != 0)
            }
        """ ;
    ] ;

    # Rebirth Rule 2: Upsilon grows by the sim's factor — upsilon *= 1.5
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ego Collapse Violation: The reborn soliton's upsilon does not equal the predecessor's upsilon * 1.5, the growth factor executeEgoCollapse() implements in soliton_sim.py." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?newUpsilon AS ?value)
            WHERE {
                $this dm:upsilon ?upsilon ;
                      dm:collapsedInto ?reborn .
                ?reborn dm:upsilon ?newUpsilon .
                FILTER (ABS(?newUpsilon - (?upsilon * 1.5e0)) > 0.0001)
            }
        """ ;
    ] ;

    # Rebirth Rule 3: Mythic charge doubles (README law; ego-collapse-runtime.rq agrees)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ego Collapse Violation: The reborn soliton's mythicCharge is not double the predecessor's mythicCharge." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?newCharge AS ?value)
            WHERE {
                $this dm:mythicCharge ?charge ;
                      dm:collapsedInto ?reborn .
                ?reborn dm:mythicCharge ?newCharge .
                FILTER (ABS(?newCharge - (?charge * 2.0e0)) > 0.0001)
            }
        """ ;
    ] ;

    # Rebirth Rule 4 (`?` proxy): Memory is compressed, never amplified —
    # |curlValue(reborn)| <= |curlValue(predecessor)| when both are recorded.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ego Collapse Violation: The reborn soliton's memory momentum magnitude exceeds the predecessor's — memory must be compressed by collapse, not amplified. (Checkable proxy `?` for the memory-vector compression law.)" ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?newCurl AS ?value)
            WHERE {
                $this dm:memoryMomentum/dm:curlValue ?curl ;
                      dm:collapsedInto ?reborn .
                ?reborn dm:memoryMomentum/dm:curlValue ?newCurl .
                FILTER (ABS(?newCurl) > ABS(?curl))
            }
        """ ;
    ] .

### 🌊 THE ANTI-CAPTURE PROPAGATION SHAPE
# A soliton that propagatesIn a FieldMedium must leave a circulation
# record, and the record must balance: potentialExpansion = Υ · curl(M⃗),
# the MED propagator law (∂æ/∂Δ = Υ · (∇⧖ × M⃗)) checked on the
# propagating soliton's snapshot. Propagation with no record, or with a
# record that does not balance, is extraction-without-circulation at the
# data level. (The structural shape above checks the same balance wherever
# the values happen to be recorded; this shape makes the record — and the
# balance — mandatory precisely when propagation is claimed.)
dm:AntiCapturePropagationShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # Anti-Capture Rule 1: Propagation without a circulation record
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Anti-Capture Violation: This soliton propagates in a medium but records no circulation (missing potentialExpansion and/or memory momentum curl). Propagation without circulation is extraction." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?medium AS ?value)
            WHERE {
                $this dm:propagatesIn ?medium .
                FILTER (
                    NOT EXISTS { $this dm:potentialExpansion ?anyPotential }
                    || NOT EXISTS { $this dm:memoryMomentum/dm:curlValue ?anyCurl }
                )
            }
        """ ;
    ] ;

    # Anti-Capture Rule 2: The propagation record must balance (MED law)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Anti-Capture Violation: The propagation record does not balance — potentialExpansion does not equal Upsilon * curl(memory momentum). The medium was changed without the circulation the MED propagator law requires." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?actualPotential AS ?value)
            WHERE {
                $this dm:propagatesIn ?medium ;
                      dm:upsilon ?u ;
                      dm:potentialExpansion ?actualPotential ;
                      dm:memoryMomentum/dm:curlValue ?curl .
                BIND (?u * ?curl AS ?computedPotential)
                FILTER (ABS(?actualPotential - ?computedPotential) > 0.0001)
            }
        """ ;
    ] .
