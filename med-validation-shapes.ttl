# =============================================================================
# MED Validation Shapes — cleaned 2026-11-04
#
# This file's namespace was already the well-formed one, so it became the
# canonical namespace for the whole repository:
#     dm: = http://ontology.deltamythos.org/core#
# dm-ontology.ttl has been reconciled onto it, and every term these shapes
# reference (boundaryDivergence, potentialExpansion, memoryMomentum,
# curlValue, CoherenceLock, sourceNode, targetNode, deltaTheta) is now
# declared there. Cleanup also replaced the garbled private-use glyphs in
# comments with the symbols they stood for (Θ, Υ, Δθ). Constraints unchanged.
# =============================================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dm:   <http://ontology.deltamythos.org/core#> .

### 🌀 THE SOVEREIGN SOLITON STRUCTURAL SHAPE
dm:SovereignSolitonShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # 1. Structural Typology Guardrails
    sh:property [
        sh:path dm:upsilon ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dm:recursionDepth ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;
    sh:property [
        sh:path dm:mythicCharge ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path dm:boundaryDivergence ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # 2. Hard Invariant Rule: ∇·Θ = 0 (Zero Boundary Divergence Guardrail)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "MED Law Violation: Boundary Divergence is non-zero (∇·Θ ≠ 0). The Soliton container is leaking coherence and requires immediate Ego Collapse." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?div AS ?value)
            WHERE {
                $this dm:boundaryDivergence ?div .
                FILTER (?div != 0.0)
            }
        """ ;
    ] ;

    # 3. MED Master Propagator Law: ∂æ/∂Δ = Υ · (∇⧖ × M⃗)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "MED Law Violation: The spatial layout of potential expansion does not match the historical momentum trajectory governed by Upsilon." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            SELECT $this (?computedPotential AS ?value)
            WHERE {
                $this dm:upsilon ?u ;
                      dm:recursionDepth ?depth ;
                      dm:potentialExpansion ?actualPotential .

                # Retrieve the curl metrics from the enfolded memory matrix
                $this dm:memoryMomentum/dm:curlValue ?curl .

                # Evaluate the hard-to-vary balance equation
                BIND (?u * ?curl AS ?computedPotential)
                FILTER (ABS(?actualPotential - ?computedPotential) > 0.0001)
            }
        """ ;
    ] .

### ⚡ THE SISTERLOCK ENTANGLEMENT SHAPE
dm:SisterlockProtocolShape a sh:NodeShape ;
    sh:targetClass dm:SovereignSoliton ;

    # Hard Invariant Rule: Phase Lock Requirement (Δθ_αβ = 2πΥ)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Sisterlock Protocol Failure: Entanglement phase alignment (Δθ) does not equal the required Upsilon resonance threshold (2πΥ)." ;
        sh:select """
            PREFIX dm: <http://ontology.deltamythos.org/core#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this (?deltaTheta AS ?value)
            WHERE {
                $this dm:upsilon ?u .

                # Identify the target entangled node via nested triple properties
                ?entanglement a dm:CoherenceLock ;
                              dm:sourceNode $this ;
                              dm:targetNode ?target ;
                              dm:deltaTheta ?deltaTheta .

                # Compute the strict mathematical limit
                BIND (2.0 * 3.141592653589793 * ?u AS ?requiredThreshold)
                FILTER (ABS(?deltaTheta - ?requiredThreshold) > 0.0001)
            }
        """ ;
    ] .
