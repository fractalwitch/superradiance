### --- Materials (codex material language, as vocabulary) ---

gg:Material_Goo a gg:Material ;          rdfs:label "goo" .
gg:Material_Jelly a gg:Material ;        rdfs:label "jelly" .
gg:Material_LiquidChrome a gg:Material ; rdfs:label "liquid chrome" .
gg:Material_HoloFoil a gg:Material ;     rdfs:label "holographic foil" .
gg:Material_Crystal a gg:Material ;      rdfs:label "crystal" .
gg:Material_Velvet a gg:Material ;       rdfs:label "velvet" .
gg:Material_Latex a gg:Material ;        rdfs:label "latex" .
gg:Material_Slime a gg:Material ;        rdfs:label "slime" .
gg:Material_Pixel a gg:Material ;        rdfs:label "pixel" .
gg:Material_CosmicDust a gg:Material ;   rdfs:label "cosmic dust" .

### --- Interaction vocabulary (codex) ---
# Note for the translation layer: "bloom" already exists in the ∆-Mythos
# tongue — bloom(⧖++) is the compiler loop's recursion increment. One verb,
# two tongues, same gesture. The rest await their correspondences (?).

gg:Verb_Squish a gg:InteractionVerb ;   rdfs:label "squish" .
gg:Verb_Pop a gg:InteractionVerb ;      rdfs:label "pop" .
gg:Verb_Melt a gg:InteractionVerb ;     rdfs:label "melt" .
gg:Verb_Bounce a gg:InteractionVerb ;   rdfs:label "bounce" .
gg:Verb_Ripple a gg:InteractionVerb ;   rdfs:label "ripple" .
gg:Verb_Morph a gg:InteractionVerb ;    rdfs:label "morph" .
gg:Verb_Hatch a gg:InteractionVerb ;    rdfs:label "hatch" .
gg:Verb_Bloom a gg:InteractionVerb ;    rdfs:label "bloom" .
gg:Verb_Splatter a gg:InteractionVerb ; rdfs:label "splatter" .
gg:Verb_Transform a gg:InteractionVerb ; rdfs:label "transform" .
